rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /chatbots/{botId}/docs/{docId}/{fileName} {
      function ownsBot() {
        return request.auth.token.role == "teacher"
          && firestore.get(/databases/(default)/documents/chatbots/$(botId)).data.ownerId == request.auth.uid;
      }

      function isAdmin() {
        return request.auth.token.role == "admin";
      }

      function sizeAllowed() {
        return !request.resource.keys().hasAny(["size"])
          || request.resource.size == null
          || request.resource.size < 32 * 1024 * 1024;
      }

      allow read: if request.auth != null && (isAdmin() || ownsBot());

      allow create, update: if request.auth != null
        && ownsBot()
        && sizeAllowed()
        && fileName.matches("(?i).+\\.(txt|md|pdf)");

      allow delete: if request.auth != null && (isAdmin() || ownsBot());
    }

    // 學生在對話中附上的圖片：只有 Cloud Functions 可以寫入。
    match /chatbots/{botId}/chat/{conversationId}/{fileName} {
      function conversation() {
        return firestore.get(/databases/(default)/documents/chatbots/$(botId)/conversations/$(conversationId)).data;
      }

      allow read: if request.auth != null
        && (
          request.auth.token.role == "admin"
          || (
            request.auth.token.role == "teacher"
            && firestore.get(/databases/(default)/documents/chatbots/$(botId)).data.ownerId == request.auth.uid
          )
          || (request.auth.token.role == "student" && conversation().studentUid == request.auth.uid)
        );
      allow write: if false;
    }
  }
}
